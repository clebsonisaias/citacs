# URL interna da NBI do GenieACS (rede Docker do Coolify)
GENIEACS_NBI_URL=http://nbi:7557
# Login do painel
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar a sessão (gere com: openssl rand -hex 32)
