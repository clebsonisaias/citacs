# CITacs Environment Configuration

# Servidor & Portas
NODE_ENV=production
PORT=4000
WEB_PORT=3000

# GenieACS TR-069 Integration
# Em ambiente Docker interno na VPS, o container se chama "nbi:7557"
GENIEACS_NBI_URL=http://nbi:7557

# Banco de Dados Operacional (PostgreSQL)
DATABASE_URL=postgresql://citacs:citacs_secure_pass@citacs-postgres:5432/citacs?schema=public

# Filas & Cache (Redis)
REDIS_HOST=citacs-redis
REDIS_PORT=6379

# Provedor de IA (OpenAI Multi-Provider)
# Adicione sua chave para ativar a LLM gpt-4o-mini (se vazio, usa heurística local de telecom)
OPENAI_API_KEY=

# Telegram Bot API (Alertas de NOC e quedas massivas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Mercado Pago (Pagamentos de Assinaturas SaaS)
MERCADO_PAGO_ACCESS_TOKEN=

# Autenticação JWT
JWT_SECRET=citacs_super_secret_jwt_key_change_in_production
